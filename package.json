{
  "name": "sigi",
  "productName": "SIGI Interventoría",
  "version": "0.1.0",
  "description": "Sistema Integral de Gestión de Interventoría",
  "main": "main.js",
  "scripts": {
    "app": "electron .",
    "servidor": "node server.js",
    "instalador": "electron-builder --win nsis"
  },
  "build": {
    "appId": "co.simo.sigi",
    "productName": "SIGI Interventoría",
    "files": [
      "main.js",
      "server.js",
      "schema.sql",
      "seed/**",
      "public/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "SIGI Interventoría"
    }
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0"
  }
}
